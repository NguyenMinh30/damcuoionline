{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "client": {
            "root": "client",
            "framework": "create-react-app"
        },
        "server": {
            "root": "server",
            "framework": "express",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/socket.io/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/socket.io",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}